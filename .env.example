# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Guild (Server) ID — right-click your server icon → Copy Server ID
GUILD_ID=your_guild_id_here

# OpenAI API Key (for the AI agent; leave blank to disable)
OPENAI_API_KEY=your_openai_api_key_here

# Channel IDs — right-click the channel → Copy Channel ID
ADMIN_CHANNEL_ID=admin_channel_id_here
LOG_CHANNEL_ID=log_channel_id_here
KILLBOARD_CHANNEL_ID=killboard_channel_id_here

# Role IDs — Server Settings → Roles → right-click → Copy Role ID
ADMIN_ROLE_ID=admin_role_id_here
MEMBER_ROLE_ID=member_role_id_here
OFFICER_ROLE_ID=officer_role_id_here

# Database path (SQLite)
DATABASE_PATH=data/weeping_ghosts.db
